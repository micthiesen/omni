[
  {
    "label": "Codex",
    "command": "codex",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "Server",
    "command": "npx @dotenvx/dotenvx run -- cargo run -p omni",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Frontend Dev",
    "command": "trunk serve",
    "cwd": "$ZED_WORKTREE_ROOT/crates/omni-web",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Frontend Build",
    "command": "trunk build --release",
    "cwd": "$ZED_WORKTREE_ROOT/crates/omni-web",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Build",
    "command": "cargo build --workspace",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Clippy",
    "command": "cargo clippy --workspace --all-targets -- -D warnings",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Format",
    "command": "cargo fmt --all",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Test",
    "command": "cargo test --workspace",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Gate",
    "command": "cargo xtask gate",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Docker Build",
    "command": "docker build -t omni .",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Seed Pet Data",
    "command": "npx @dotenvx/dotenvx run -- cargo run -p omni-personal --bin omni-pets-seed",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  }
]
