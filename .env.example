# shellcheck disable=SC2034

LOG_LEVEL=
DB_NAME=
LOGS_PATH=
TZ=America/Vancouver
FRONTEND_PORT=3000
# Private Executor MCP endpoint (/mcp). Use a random 32+ character token;
# production refuses to start when this is missing or weak.
OMNI_MCP_TOKEN=
# Optional device token for the Mac's omni-link agent (/device-link/*). Enables
# the claude_* MCP tools. Random 32+ characters, different from OMNI_MCP_TOKEN.
OMNI_DEVICE_LINK_TOKEN=
# Optional fixed internal Executor endpoint for event owner revocation checks.
# Docker default: http://executor:4788/api/auth/mcp/get-session
OMNI_EVENTS_EXECUTOR_AUTH_URL=
# Optional public https:// origin of the MCP gateway (/gateway/mcp), for ChatGPT OAuth
# and integration OAuth callbacks. Unset keeps the gateway on the LAN only.
OMNI_GATEWAY_PUBLIC_URL=
# Optional private browser history and captured-page search through Omni MCP.
HISTER_URL=https://hister.syas.ca
HISTER_ACCESS_TOKEN=
# Optional fixed IPP printer endpoint. Enables the MCP printer tools.
PRINTER_IPP_URL=
PUSHOVER_USER=
PUSHOVER_TOKEN=
PUSHOVER_LIVE_TOKEN=      # Optional, falls back to PUSHOVER_TOKEN (YouTube/Twitch/Kick share this)
# Streamers are configured in the UI (Live > Manage streamers) or over MCP, not env.
KICK_CLIENT_ID=           # From https://dev.kick.com app (OAuth Client Credentials)
KICK_CLIENT_SECRET=       # From https://dev.kick.com app
OFFLINE_NOTIFICATIONS=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Email pipelines
EMAIL_SELF_ADDRESS=       # Your receiving address for self-sent-mail filtering (default: ICLOUD_USERNAME)

# iCloud (IMAP email monitoring + CalDAV calendar)
ICLOUD_USERNAME=          # iCloud primary username (user@icloud.com, NOT the custom-domain address)
ICLOUD_APP_PASSWORD=      # App-specific password (account.apple.com → Sign-In & Security)
ICLOUD_CALENDAR_NAME=     # Optional: display name of the target calendar (e.g. Personal)
ICLOUD_CALENDAR_URL=      # Optional: previously discovered collection URL (skips discovery)

PARCEL_API_KEY=           # Parcel.app API key (optional, enables parcel tracking)
EXTRACTION_MODEL=openai:gpt-6-luna           # Parcel extraction
CALENDAR_EXTRACTION_MODEL=openai:gpt-6-sol  # Calendar extraction (stronger)
TRIAGE_MODEL=openai:gpt-6-luna               # Shared email relevance triage
PUSHOVER_CALENDAR_TOKEN=  # Optional, falls back to PUSHOVER_TOKEN

# Media recommendations
TMDB_API_KEY=              # themoviedb.org API key (v3 key or v4 read access token)
RECS_SHORTLIST_MODEL=openai:gpt-6-luna
RECS_SELECTION_MODEL=openai:gpt-6-sol
TASTE_REFLECTION_MODEL=openai:gpt-6-luna
TASTE_REFLECTION_SCHEDULE= # Optional, default "0 0 4 * * 0" (Sunday 4am)
RECS_SCHEDULE=             # Optional, default "0 0 17 * * 1,3,5" (Mon/Wed/Fri 5pm)
RECS_PUBLIC_URL=http://omni.boris
PUSHOVER_RECS_TOKEN=       # Optional, falls back to PUSHOVER_TOKEN
PLEX_URL=http://plex.boris
PLEX_TOKEN=
PLEX_ACCOUNT_ID=           # Optional; required if history contains multiple Plex users
RADARR_URL=http://radarr.boris
RADARR_API_KEY=
RADARR_ROOT_FOLDER_PATH=
RADARR_QUALITY_PROFILE_ID=
SONARR_URL=http://sonarr.boris
SONARR_API_KEY=
ARR_RECOVERY_ENABLED=true
# Optional corroboration of terminal NZBGet failures (local unauthenticated API).
NZBGET_URL=http://nzbget.boris
# Enable only when Omni has the read-only download mounts from docs/arr-recovery.md.
ARR_RECOVERY_LOCAL_FILES=false
SONARR_ROOT_FOLDER_PATH=
SONARR_QUALITY_PROFILE_ID=

# Podcast recommendations (enabled by setting PODCAST_TASTE_PATH)
PODCAST_TASTE_PATH=          # Markdown listener profile; doubles as the feature flag
PODCAST_RECS_SCHEDULE=       # Optional, default "0 0 11 * * 1,3,5" (Mon/Wed/Fri 11am)
PUSHOVER_PODCAST_TOKEN=      # Optional, falls back to PUSHOVER_TOKEN
CASTRO_ACCESS_ID=            # Optional: Castro device credential UUID
CASTRO_SECRET_KEY=           # Optional: Castro device HMAC secret (keep private)
PODCASTINDEX_KEY=            # Optional: Podcast Index API key (guest-appearance discovery)
PODCASTINDEX_SECRET=         # Optional: Podcast Index API secret (QUOTE it; secrets contain #)
PODCAST_VOICE_ROTATION_MAX=  # Optional, default 12 (voices person-searched per run)
PODCAST_MAX_GUEST_PICKS=     # Optional, default 6 (Tier-1 guest picks cap per run)
PODCAST_TASTE_REFLECTION_MODEL=    # Optional, default openai:gpt-6-luna
PODCAST_TASTE_REFLECTION_SCHEDULE= # Optional, default "0 0 5 * * 0" (Sunday 5am)

# PressPods: article → podcast episodes (enabled by setting PRESSPODS_AUTH_TOKEN)
PRESSPODS_AUTH_TOKEN=        # Long random secret; authenticates /pods/episodes + /pods/rss
PRESSPODS_PUBLIC_URL=        # Optional: public origin for RSS enclosure URLs (else derived per request)
PRESSPODS_AUDIO_DIR=         # Optional: episode MP3 dir (default: press-pods-audio next to the DB)
PRESSPODS_METADATA_MODEL=    # Optional, default openai:gpt-6-luna (rates each retriever)
PRESSPODS_CLEANING_MODEL=    # Optional, default openai:gpt-6-sol (narration rewrite)
PRESSPODS_TTS_PROVIDER=higgs # TTS backend: higgs (self-hosted, default) or elevenlabs
PRESSPODS_TTS_URL=           # mlx-audio server URL, e.g. http://10.10.1.90:8000 (required for higgs)
PRESSPODS_TTS_MODEL=         # Optional: Higgs model repo (default bosonai/higgs-audio-v3-tts-4b)
PRESSPODS_STT_URL=           # Optional: OpenAI-compatible STT endpoint for chunk content verification (default: PRESSPODS_TTS_URL)
PRESSPODS_STT_MODEL=         # Optional: STT model id (default mlx-community/parakeet-tdt-0.6b-v3)
PRESSPODS_HIGGS_REF_AUDIO=   # Optional: reference-clip path ON THE MLX HOST to pin one voice (with REF_TEXT)
PRESSPODS_HIGGS_REF_TEXT=    # Optional: transcript of the reference clip (required alongside REF_AUDIO)
ELEVENLABS_API_KEY=          # ElevenLabs v3 TTS (required when PRESSPODS_TTS_PROVIDER=elevenlabs)
ELEVENLABS_VOICE_MALE=       # Optional: voice id for male-author narration (default: Brian)
ELEVENLABS_VOICE_FEMALE=     # Optional: voice id for female/unknown-author narration (default: Matilda)
MISTRAL_API_KEY=             # Unused: the tts-bakeoff comparison tool was not ported to Rust
JINA_API_KEY=                # Optional: enables the Jina.ai Reader retriever
PUSHOVER_PRESSPODS_TOKEN=    # Optional, falls back to PUSHOVER_TOKEN
KARAKEEP_URL=                # Optional: bookmark submitted articles in Karakeep
KARAKEEP_API_KEY=            # Optional

# Email via SMTP (optional; MCP composition falls back to existing iCloud credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=michael@thiesen.dev # Fixed outgoing identity; other values fail boot
LOGS_EMAIL_TO=

# Observer (Overseerr) issue repair with Luna; requires Arr/OpenAI/Pushover keys
OBSERVER_URL=http://overseerr:5055
OBSERVER_API_KEY=
OBSERVER_REPAIR_ENABLED=true
## Server iCloud Reminders: disabled until explicitly configured. Separate from IMAP/CalDAV.
ICLOUD_REMINDERS_ENABLED=false
ICLOUD_REMINDERS_ACCOUNT=
ICLOUD_REMINDERS_PASSWORD=
ICLOUD_REMINDERS_STORAGE_KEY=
ICLOUD_REMINDERS_PUBLIC_ORIGIN=

## Omni iOS app (docs/ios-app.md). The auth token enables the signed app API;
## all four APNs values enable app notifications (Pushover becomes the
## fallback), widget pushes and Control Center reloads.
IOS_CONTROL_AUTH_TOKEN=
IOS_CONTROL_HOME_URL=http://omni.boris
IOS_CONTROL_APNS_TEAM_ID=
IOS_CONTROL_APNS_KEY_ID=
IOS_CONTROL_APNS_KEY_PATH=   # e.g. /data/AuthKey_KEYID.p8
IOS_CONTROL_BUNDLE_ID=com.micthiesen.OmniLive
